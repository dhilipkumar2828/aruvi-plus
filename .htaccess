<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Secure sensitive files
    RewriteRule ^(\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]

    # Rewrite all requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
